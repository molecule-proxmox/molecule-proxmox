#
# Copy this file to .envrc and add your test values, then source the .envrc
# script to export all environment variables to the current shell.
#
#     $ . .envrc
#
export TEST_PROXMOX_TEMPLATE_NAME=
export TEST_PROXMOX_TEMPLATE_VMID=
export TEST_PROXMOX_PORT=
export TEST_PROXMOX_USER=
export TEST_PROXMOX_SSH_IDENTITY_FILE=
export TEST_PROXMOX_PASSWORD=
export TEST_PROXMOX_SSH_USER=
export TEST_PROXMOX_VALIDATE_CERTS="true"
export TEST_PROXMOX_NODE=
export TEST_PROXMOX_HOST=
export TEST_PROXMOX_SECRETS_FILE=
export TEST_PROXMOX_TOKEN_ID=
export TEST_PROXMOX_TOKEN_SECRET=
export TEST_PROXMOX_SECRETS_SCRIPT=
export TEST_PROXMOX_CLOUDINIT=
export TEST_PROXMOX_DEBUG="false"
export TEST_PROXMOX_FULL_CLONE="false"
export TEST_PROXMOX_NAMESERVER=
# Optional: An existing machine for the unmanaged instance test. The
# test is skipped when the address is not set.
export TEST_PROXMOX_UNMANAGED_ADDRESS=
export TEST_PROXMOX_UNMANAGED_SSH_USER=
export TEST_PROXMOX_UNMANAGED_SSH_PORT=
export TEST_PROXMOX_UNMANAGED_SSH_IDENTITY_FILE=
# Optional: A second node for the multiple node test. The node must have
# a local copy of the template. The test is skipped when not set.
export TEST_PROXMOX_NODE2=
